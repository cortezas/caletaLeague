# ==========================================================================
# La Caleta League - plantilla de variables de entorno
#
# Copia este fichero a .env.local y rellena los valores reales:
#   cp .env.example .env.local
#
# .env.local NO se commitea (.gitignore ya cubre .env*).
#
# La app arranca y funciona SIN estas variables (fase A: datos de seed).
# Si faltan, src/lib/supabase/proxy.ts deja pasar todas las rutas sin
# redirigir a /login, en vez de reventar. En cuanto las rellenes, el guardado
# de sesion y el magic link se activan solos.
# ==========================================================================

# URL del proyecto. Dashboard > Project Settings > Data API > Project URL.
# Formato: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (la que en proyectos antiguos se llamaba "anon public").
# Dashboard > Project Settings > API Keys > Publishable key.
# Es PUBLICA por diseno: viaja al navegador. La frontera de seguridad real es
# RLS, no esta clave. NUNCA pongas aqui la secret / service_role key: se
# saltaria todas las politicas RLS y quedaria expuesta en el bundle del cliente.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ==========================================================================
# Ingesta de partidos y resultados (football-data.org)  ->  docs/INGESTA.md
#
# Las cuatro variables de este bloque son OPCIONALES. Sin ellas la app arranca
# y funciona igual, con el calendario de src/lib/laliga.ts; lo unico que no
# funciona es POST /api/sync, que contesta 503 explicando que falta.
# ==========================================================================

# Token del plan gratuito de football-data.org (registro gratis, llega por
# correo en un minuto). Da partidos, horarios, estados y resultados de LaLiga.
# NO da jugadores: plantillas, alineaciones y goleadores son de pago, por eso
# el MVP y los goleadores los mete el organizador a mano.
#
# SIN prefijo NEXT_PUBLIC_ a proposito: si viajase al navegador, cualquiera
# podria quemar la cuota de 10 peticiones/minuto.
FOOTBALL_DATA_TOKEN=

# Secreto que protege POST /api/sync. Lo manda el cron en la cabecera
# `X-Cron-Secret` (o como `Authorization: Bearer <secreto>`).
# Genera uno con:  openssl rand -hex 32
#
# Si esta vacio, /api/sync responde 503 y NO se queda abierta. Una ruta que
# escribe resultados y horas de partido no puede estar sin autenticar.
CRON_SECRET=

# Clave SECRETA de Supabase (Dashboard > Project Settings > API Keys >
# service_role / secret key). Solo la usa src/lib/football-data/ingest.ts.
#
# Hace falta porque el cron no tiene sesion de usuario y las politicas RLS de
# `matches` y `gameweeks` solo dejan escribir al admin autenticado. Esta clave
# SE SALTA RLS por completo.
#
# NUNCA la pongas con prefijo NEXT_PUBLIC_ ni la uses en ningun otro fichero:
# acabaria en el bundle del navegador y con ella se pueden reescribir
# resultados, horas de partido y pronosticos de cualquiera.
SUPABASE_SERVICE_ROLE_KEY=

# Solo si algun dia hay mas de una liga en la base: id de la que se alimenta de
# la API. Con una sola liga, dejalo vacio y la ingesta la encuentra sola.
SYNC_LEAGUE_ID=


# ==========================================================================
# Avisos antes del cierre (Web Push)  ->  docs/AVISOS.md
#
# Las tres variables de este bloque son OPCIONALES y van JUNTAS: o estan las
# tres o no esta ninguna. Si falta alguna, el interruptor de /ajustes sale
# deshabilitado con la explicacion y /api/push/* responde 503. Nunca a medias.
#
# Genera el par de claves con:  npx web-push generate-vapid-keys
#
# CAMBIARLAS INVALIDA TODAS LAS SUSCRIPCIONES EXISTENTES. La pena entera
# tendria que volver a activar el interruptor. Guardalas donde no se pierdan.
# ==========================================================================

# Clave publica VAPID: 87 caracteres base64url (65 bytes al decodificar).
# Es publica por diseno (viaja a todos los navegadores que se suscriben), pero
# NO lleva prefijo NEXT_PUBLIC_: la sirve GET /api/push/subscribe, que ya exige
# sesion, y asi no hay que reconstruir el bundle para cambiarla.
VAPID_PUBLIC_KEY=

# Clave privada VAPID: 43 caracteres base64url (32 bytes al decodificar).
# SECRETA. Con ella cualquiera puede mandar notificaciones a los moviles de la
# pena en nombre de esta app. Nunca con prefijo NEXT_PUBLIC_, nunca en el repo.
VAPID_PRIVATE_KEY=

# Contacto que el servicio de push (Google, Apple, Mozilla) usa si tus envios
# dan problemas. Tiene que empezar por "mailto:" o por "https://".
# Ejemplo: mailto:organizador@lacaleta.example
VAPID_SUBJECT=

# El cron de avisos reutiliza el CRON_SECRET de mas arriba: POST a
# /api/push/dispatch con la cabecera X-Cron-Secret. Sin ese secreto la ruta
# responde 503 y no queda abierta.


# ==========================================================================
# Configuracion que NO va en este fichero, sino en el dashboard de Supabase
# ==========================================================================
#
# 1) Authentication > URL Configuration
#    - Site URL:      http://localhost:3000 en local, el dominio real en prod.
#    - Redirect URLs: anade http://localhost:3000/** y https://<dominio>/**
#
# 2) Authentication > Emails > Magic Link
#    OBLIGATORIO cambiar el enlace de la plantilla por este, tal cual:
#
#      {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=email&next={{ .RedirectTo }}
#
#    La plantilla que trae Supabase por defecto usa {{ .ConfirmationURL }},
#    que dispara el flujo PKCE con `code`. Ese flujo NO funciona aqui (D10):
#    el code_verifier se queda en el navegador que pidio el enlace y en movil
#    el correo se abre en otro navegador. Con token_hash + verifyOtp el enlace
#    es autosuficiente y se puede abrir donde sea.
#
# 3) Authentication > Providers > Email
#    - Enable Email provider: ON
#    - Confirm email: ON
#    - Con solo magic link, deja "Enable email signup" segun quieras que la
#      pena sea abierta o de invitacion.
